@using System.Security.Claims
@model AdsBoard.Models.Advertisement

@{
    ViewData["Title"] = Model.Title;
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="col-md-5 mb-3">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded"/>
        </div>
    }
    
    <dl>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Category)
    </dt>
    <dd class="col-sm-10">
        @Model.Category?.Name
    </dd>
</dl>
<dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("N2") грн.
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.City)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Phone)
        </dd>
    </dl>
     
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreateAt)
        </dt>
        <dd class = "col-sm-10">
         @Model.CreateAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @(Model.IsActive?"Активне":"Неактивне")
        </dd>
    </dl>     
      
</div>
<div>
    @if(Model.UserId==User.FindFirstValue(ClaimTypes.NameIdentifier)){
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
        <span>  |</span>    }
 
    <a asp-action="Index">Back to List</a>
</div>
